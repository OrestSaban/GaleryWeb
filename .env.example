# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmno.supabase.co
# If the dashboard shows only a Project ID, the URL is https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The browser-safe key. In the current dashboard this is the "publishable key"
# (sb_publishable_...); older projects call the same thing the "anon / public"
# key (a JWT starting eyJ...). Either works — they go in the same place.
#
# Safe to expose to the browser: RLS decides what it can actually read.
#
# ⚠️  NEVER put the "secret key" (sb_secret_... / service_role) here. It bypasses
#     RLS entirely, and anything named NEXT_PUBLIC_* is compiled into the client
#     bundle where every visitor can read it. This app never needs it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Canonical site URL (no trailing slash). Used for metadata / Open Graph.
# Local: http://localhost:3000   Production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
