# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / public key. Safe to expose to the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Canonical site URL (no trailing slash). Used for metadata / Open Graph.
# Local: http://localhost:3000   Production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
